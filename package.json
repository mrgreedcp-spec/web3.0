{
  "name": "web3-airdrop-farmer",
  "version": "1.0.0",
  "description": "Automated testnet faucet claiming and airdrop farming bot",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node index.js",
    "status": "node scripts/status.js",
    "claim": "node -e \"require('./src/faucets').runAll().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "interact": "node -e \"require('./src/protocols').runAll().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.0",
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  }
}
