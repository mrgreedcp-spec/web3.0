# ============================================
# Web3 Airdrop Farmer - Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Wallet encryption password (REQUIRED - set a strong password)
WALLET_PASSWORD=

# Number of wallets to manage (default: 3)
WALLET_COUNT=3

# Schedule: cron expressions
# Faucet claiming (default: every day at 8:00 AM)
FAUCET_SCHEDULE=0 8 * * *
# Protocol interactions (default: every 12 hours)
PROTOCOL_SCHEDULE=0 */12 * * *
# Airdrop tracker refresh (default: every 6 hours)
TRACKER_SCHEDULE=0 */6 * * *

# Enable/disable chains (1=on, 0=off)
ENABLE_SEPOLIA=1
ENABLE_BASE_SEPOLIA=1
ENABLE_ARBITRUM_SEPOLIA=1

# RPC endpoints (free public defaults are used if not set)
# SEPOLIA_RPC=https://rpc.sepolia.org
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Anti-detection settings
# Min delay between transactions in seconds (default: 60)
MIN_DELAY=60
# Max delay between transactions in seconds (default: 300)
MAX_DELAY=300
# Max random jitter added to schedule in minutes (default: 30)
SCHEDULE_JITTER=30
